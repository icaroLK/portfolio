# Copy this file to .env and fill in real values.
# .env is ignored by git and must never be committed.

# Long random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# True on your computer, False on the server
DEBUG=True

# Comma-separated domains the site answers to (empty = localhost in dev)
ALLOWED_HOSTS=localhost,127.0.0.1

# Private admin path, without slashes. Pick something hard to guess.
ADMIN_PATH=painel-change-me

# Optional. Defaults to db.sqlite3 in the project root.
# DATABASE_URL=sqlite:///db.sqlite3

# Production only: the main address, without www (www. redirects to it)
# CANONICAL_HOST=icarokucha.com

# Production only: full origins allowed to submit forms
# CSRF_TRUSTED_ORIGINS=https://icarokucha.com,https://www.icarokucha.com

# Sender address of contact form notifications. In production use an address
# on the domain you verified in Resend, e.g. Icaro Kucha <site@icarokucha.com>
# DEFAULT_FROM_EMAIL=webmaster@localhost

# Production only: Resend API key (resend.com > API Keys). Dev prints emails in the terminal.
# The server sends through Resend's HTTP API, not SMTP, because it only has IPv6.
# The address that receives the notifications is set in the admin, under Site settings.
# RESEND_API_KEY=
